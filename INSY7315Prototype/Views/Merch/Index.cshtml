@model INSY7315Prototype.Models.MerchPageViewModel
@{
    ViewData["Title"] = "Merch";
}

<style>
    .merch-single {
        max-width: 22rem;
        margin: 0 auto;
    }

    .merch-card {
        background: var(--card);
        border: 1px solid var(--hairline);
        border-radius: 1.25rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .merch-card:hover {
            box-shadow: 0 10px 24px rgba(0,0,0,0.08);
            transform: translateY(-2px);
        }

    .merch-card__img-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        background: color-mix(in srgb, var(--hairline) 40%, transparent);
        perspective: 1200px;
    }

    .merch-flip {
        position: absolute;
        inset: 0;
        cursor: pointer;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
    }

        .merch-flip.is-flipped {
            transform: rotateY(180deg);
        }

    .merch-flip__face {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

        .merch-flip__face img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .merch-flip__face--back {
        transform: rotateY(180deg);
    }

    .merch-flip__hint {
        position: absolute;
        bottom: 0.6rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.55);
        color: white;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.3rem 0.7rem;
        border-radius: 9999px;
        pointer-events: none;
        z-index: 5;
        transition: opacity .2s ease;
    }

    .merch-card__badge {
        position: absolute;
        top: 0.7rem;
        left: 0.7rem;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.3rem 0.6rem;
        border-radius: 9999px;
        z-index: 10;
    }

        .merch-card__badge.is-new {
            background: var(--red);
            color: white;
        }

        .merch-card__badge.is-soldout {
            background: var(--ink);
            color: white;
        }

    .merch-card__soldout-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.55);
        z-index: 9;
    }

    .merch-card__body {
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .merch-card__category {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 0.3rem;
    }

    .merch-card__name {
        font-family: var(--font-display, inherit);
        font-size: 1.05rem;
        line-height: 1.3;
        margin-bottom: 0.35rem;
    }

    .merch-card__desc {
        font-size: 12.5px;
        color: var(--muted);
        line-height: 1.5;
        margin-bottom: 0.9rem;
    }

    .merch-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: auto;
    }

    .merch-card__price {
        font-weight: 700;
        font-size: 1rem;
    }

    .merch-card__stock {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 0.35rem 0.7rem;
        border-radius: 9999px;
    }

        .merch-card__stock.is-in {
            background: color-mix(in srgb, var(--ink) 8%, transparent);
            color: var(--ink);
        }

        .merch-card__stock.is-out {
            background: color-mix(in srgb, var(--red) 10%, transparent);
            color: var(--red);
        }

    /* ================= RESPONSIVE BREAKPOINTS ================= */

    @@media only screen and (max-width: 480px) {
        .merch-single {
            max-width: 100%;
        }

        .merch-card__name {
            font-size: 0.95rem;
        }
    }
</style>

<section class="max-w-6xl mx-auto px-6 md:px-12 py-10">

    <h1 class="font-display text-3xl mb-2">Kingdom Cats Merch</h1>
    <p class="text-[var(--muted)] text-sm max-w-2xl mb-6">
        Every purchase directly supports the food, medical care, and shelter of our sanctuary residents.
        Wear it, sip from it, or carry it — it all helps.
    </p>

    <!-- Merch item -->
    <div class="merch-single">
        @foreach (var item in Model.Items)
        {
            <div class="merch-card">
                <div class="merch-card__img-wrap">
                    @if (item.IsNew && !item.IsSoldOut)
                    {
                        <span class="merch-card__badge is-new">New</span>
                    }
                    @if (item.IsSoldOut)
                    {
                        <span class="merch-card__badge is-soldout">Sold out</span>
                    }
                    @if (!string.IsNullOrEmpty(item.PhotoUrl))
                    {
                        <div class="merch-flip" onclick="this.classList.toggle('is-flipped')">
                            <div class="merch-flip__face merch-flip__face--front">
                                <img src="~/images/tshirtFront.png" alt="@item.Name — front">
                            </div>
                            @if (!string.IsNullOrEmpty(item.BackPhotoUrl))
                            {
                                <div class="merch-flip__face merch-flip__face--back">
                                    <img src="~/images/tshirtBack.png" alt="@item.Name — back">
                                </div>
                                <span class="merch-flip__hint">Click to flip</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center">
                            <p class="text-[10px] text-[var(--muted)] uppercase tracking-wide px-2 text-center">Photo — @item.Name</p>
                        </div>
                    }
                    @if (item.IsSoldOut)
                    {
                        <div class="merch-card__soldout-overlay"></div>
                    }
                </div>

                <div class="merch-card__body">
                    <p class="merch-card__category">@item.Category</p>
                    <h3 class="merch-card__name">@item.Name</h3>
                    <p class="merch-card__desc">@item.Description</p>

                    <div class="merch-card__footer">
                        <span class="merch-card__price">R@(item.Price.ToString("0.00"))</span>
                        @if (item.IsSoldOut)
                        {
                            <span class="merch-card__stock is-out">Sold out</span>
                        }
                        else
                        {
                            <span class="merch-card__stock is-in">In stock</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

