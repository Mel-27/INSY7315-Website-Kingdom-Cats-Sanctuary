@model INSY7315Prototype.Models.MerchPageViewModel
@{
    ViewData["Title"] = "Merch";
}

<style>
    /* ---------- Page Header Block ---------- */
    .merch-page-header {
        max-width: 24rem;
        margin: 2rem auto 0;
        padding: 1.25rem 1.4rem;
        background: linear-gradient( 135deg, color-mix(in srgb, var(--red) 18%, var(--cream)), color-mix(in srgb, var(--red) 5%, var(--cream)) );
        border: 1px solid color-mix(in srgb, var(--red) 18%, var(--hairline));
        border-radius: 1rem 1rem 0 0;
    }

        .merch-page-header h2 {
            font-family: var(--font-display, 'Playfair Display', serif);
            font-size: 1.4rem;
            line-height: 1.3;
            margin: 0 0 0.4rem;
            color: var(--ink);
        }

        .merch-page-header p {
            font-size: 12.5px;
            line-height: 1.6;
            color: var(--muted);
            margin: 0;
        }

    .merch-single {
        max-width: 24rem;
        margin: 0 auto;
    }

    .merch-card {
        position: relative;
        background: linear-gradient(155deg, color-mix(in srgb, var(--red) 35%, transparent), color-mix(in srgb, var(--hairline) 70%, transparent));
        border-radius: 1.5rem;
        padding: 1.5px;
        transition: box-shadow .25s ease, transform .25s ease;
    }

        .merch-card:hover {
            box-shadow: 0 16px 32px rgba(28,25,23,0.12);
            transform: translateY(-3px);
        }

    .merch-card__inner {
        background: var(--card);
        border-radius: calc(1.5rem - 1.5px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .merch-card__img-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--red) 6%, transparent), transparent 60%), color-mix(in srgb, var(--hairline) 45%, transparent);
        perspective: 1200px;
    }

    .merch-flip {
        position: absolute;
        inset: 0;
        cursor: pointer;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
    }

        .merch-flip.is-flipped {
            transform: rotateY(180deg);
        }

    .merch-flip__face {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

        .merch-flip__face img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .merch-flip__face--back {
        transform: rotateY(180deg);
    }

    .merch-flip__hint {
        position: absolute;
        bottom: 0.6rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.55);
        color: white;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.3rem 0.7rem;
        border-radius: 9999px;
        pointer-events: none;
        z-index: 5;
        transition: opacity .2s ease;
    }

    .merch-card__badge {
        position: absolute;
        top: 0.7rem;
        left: 0.7rem;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.3rem 0.6rem;
        border-radius: 9999px;
        z-index: 10;
    }

        .merch-card__badge.is-new {
            background: var(--red);
            color: white;
        }

        .merch-card__badge.is-soldout {
            background: var(--ink);
            color: white;
        }

    .merch-card__soldout-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.55);
        z-index: 9;
    }

    .merch-card__body {
        padding: 1.5rem 1.4rem 1.4rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .merch-card__category {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 0.4rem;
    }

    .merch-card__name {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: 1.3rem;
        line-height: 1.3;
        margin-bottom: 0.5rem;
    }

    .merch-card__desc {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .merch-card__divider {
        border: none;
        border-top: 1px dashed var(--hairline);
        margin: 0 0 1.1rem;
    }

    .merch-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: auto;
    }

    .merch-card__price {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--ink);
    }

    .merch-card__stock {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 0.35rem 0.7rem;
        border-radius: 9999px;
    }

        .merch-card__stock.is-in {
            background: color-mix(in srgb, var(--ink) 8%, transparent);
            color: var(--ink);
        }

        .merch-card__stock.is-out {
            background: color-mix(in srgb, var(--red) 10%, transparent);
            color: var(--red);
        }

    /* ---------- How to order ---------- */
    .buy-contact {
        max-width: 26rem;
        margin: 2.5rem auto 0;
        background: var(--ink);
        color: white;
        border-radius: 1.25rem;
        padding: 1.75rem 1.75rem 1.9rem;
        text-align: center;
    }

    .buy-contact__icon {
        width: 3rem;
        height: 3rem;
        margin: 0 auto 1rem;
        border-radius: 9999px;
        background: rgba(255,255,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .buy-contact__title {
        font-family: var(--font-display, 'Playfair Display', serif);
        font-size: 1.2rem;
        margin-bottom: 0.6rem;
    }

    .buy-contact__text {
        font-size: 13px;
        line-height: 1.65;
        color: rgba(255,255,255,0.8);
        margin-bottom: 1.4rem;
    }

    .buy-contact__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
    }

    .buy-contact__btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 0.65rem 1.15rem;
        border-radius: 0.6rem;
        text-decoration: none;
        transition: background .15s ease, color .15s ease, opacity .15s ease;
    }

    .buy-contact__btn--primary {
        background: white;
        color: var(--ink);
    }

        .buy-contact__btn--primary:hover {
            opacity: 0.9;
        }

    .buy-contact__btn--secondary {
        background: rgba(255,255,255,0.1);
        color: white;
        border: 1px solid rgba(255,255,255,0.25);
    }

        .buy-contact__btn--secondary:hover {
            background: rgba(255,255,255,0.18);
        }

    /* ================= RESPONSIVE BREAKPOINTS ================= */

    @@media only screen and (max-width: 480px) {
        .merch-single {
            max-width: 100%;
        }

        .merch-card__name {
            font-size: 1.15rem;
        }

        .buy-contact {
            margin-top: 2rem;
            padding: 1.5rem 1.25rem 1.65rem;
        }
    }

</style>




<section class="max-w-6xl mx-auto px-6 md:px-12 py-10">

    <h1 class="font-display text-3xl mb-2">Kingdom Cats Merch</h1>
    <p class="text-[var(--muted)] text-sm max-w-2xl mb-6">
        Every purchase directly supports the food, medical care, and shelter of our sanctuary residents.
        Wear it, sip from it, or carry it — it all helps.
    </p>

    <!-- Merch item -->
    <div class="merch-single">
        @foreach (var item in Model.Items)
        {
            <div class="merch-card">
                <div class="merch-card__inner">
                    <div class="merch-card__img-wrap">
                        @if (item.IsNew && !item.IsSoldOut)
                        {
                            <span class="merch-card__badge is-new">New</span>
                        }
                        @if (item.IsSoldOut)
                        {
                            <span class="merch-card__badge is-soldout">Sold out</span>
                        }
                        @if (!string.IsNullOrEmpty(item.PhotoUrl))
                        {
                            <div class="merch-flip" onclick="this.classList.toggle('is-flipped')">
                                <div class="merch-flip__face merch-flip__face--front">
                                    <img src="~/images/tshirtFront.png" alt="@item.Name — front">
                                </div>
                                @if (!string.IsNullOrEmpty(item.BackPhotoUrl))
                                {
                                    <div class="merch-flip__face merch-flip__face--back">
                                        <img src="~/images/tshirtBack.png" alt="@item.Name — back">
                                    </div>
                                    <span class="merch-flip__hint">Click to flip</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center">
                                <p class="text-[10px] text-[var(--muted)] uppercase tracking-wide px-2 text-center">Photo — @item.Name</p>
                            </div>
                        }
                        @if (item.IsSoldOut)
                        {
                            <div class="merch-card__soldout-overlay"></div>
                        }
                    </div>

                    <div class="merch-card__body">
                        <p class="merch-card__category">@item.Category</p>
                        <h3 class="merch-card__name">@item.Name</h3>
                        <p class="merch-card__desc">@item.Description</p>

                        <hr class="merch-card__divider" />

                        <div class="merch-card__footer">
                            <span class="merch-card__price">R@(item.Price.ToString("0.00"))</span>
                            @if (item.IsSoldOut)
                            {
                                <span class="merch-card__stock is-out">Sold out</span>
                            }
                            else
                            {
                                <span class="merch-card__stock is-in">In stock</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- How to order -->
    <div class="buy-contact">
        <div class="buy-contact__icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
        </div>
        <h3 class="buy-contact__title">Want one?</h3>
        <p class="buy-contact__text">
            To order, please contact the sanctuary directly — message us and we'll sort out
            sizing, payment, and pickup or delivery. All proceeds go straight back into caring for our cats.
        </p>
        <div class="buy-contact__actions">
            <a href="https://wa.me/27829020383" target="_blank" rel="noopener" class="buy-contact__btn buy-contact__btn--primary">
                WhatsApp us
            </a>
            <a asp-controller="Contact" asp-action="Index" class="buy-contact__btn buy-contact__btn--secondary">
                Contact page
            </a>
        </div>
    </div>
</section>
