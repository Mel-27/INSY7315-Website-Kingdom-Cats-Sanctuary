<div id="editProfileModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-6">

    ```
    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/50"
         onclick="closeEditProfile()">
    </div>


    <!-- Modal -->
    <div class="relative w-full max-w-lg bg-[var(--card)] rounded-2xl shadow-2xl border border-[var(--hairline)] p-6 md:p-8">

        <div class="flex items-start justify-between mb-7">

            <div>

                <p class="text-[10px] tracking-[0.18em] uppercase text-[var(--red)] mb-1">
                    Your details
                </p>

                <h2 class="font-display text-2xl">
                    Edit profile
                </h2>

                <p class="text-xs text-[var(--muted)] mt-1">
                    Update your personal information.
                </p>

            </div>


            <button type="button"
                    onclick="closeEditProfile()"
                    class="w-8 h-8 rounded-full hover:bg-[var(--cream)] text-[var(--muted)] hover:text-[var(--ink)] transition-colors">
                &times;
            </button>

        </div>


        <form onsubmit="saveProfile(event)" class="space-y-5">

            <!-- Full Name -->
            <div>

                <label for="editFullName"
                       class="block text-xs font-semibold tracking-wide uppercase text-[var(--ink)] mb-1.5">
                    Full name
                </label>

                <input id="editFullName"
                       type="text"
                       value="Gia Gounden"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">

            </div>


            <!-- Email -->
            <div>

                <label for="editEmail"
                       class="block text-xs font-semibold tracking-wide uppercase text-[var(--ink)] mb-1.5">
                    Email address
                </label>

                <input id="editEmail"
                       type="email"
                       value="gia@example.com"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">

            </div>


            <!-- Phone -->
            <div>

                <label for="editPhone"
                       class="block text-xs font-semibold tracking-wide uppercase text-[var(--ink)] mb-1.5">
                    Phone number
                </label>

                <input id="editPhone"
                       type="tel"
                       value="+27 82 000 0000"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">

            </div>


            <!-- Location -->
            <div>

                <label for="editLocation"
                       class="block text-xs font-semibold tracking-wide uppercase text-[var(--ink)] mb-1.5">
                    Location
                </label>

                <input id="editLocation"
                       type="text"
                       value="Durban, South Africa"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">

            </div>


            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 pt-2">

                <button type="button"
                        onclick="closeEditProfile()"
                        class="flex-1 border border-[var(--hairline)] hover:border-[var(--red)] hover:text-[var(--red)] transition-colors text-xs font-semibold tracking-[0.12em] uppercase rounded-lg py-3">
                    Cancel
                </button>

                <button type="submit"
                        class="flex-1 btn-primary text-white text-xs font-semibold tracking-[0.12em] uppercase rounded-lg py-3">
                    Save changes
                </button>

            </div>

        </form>

    </div>
    ```

