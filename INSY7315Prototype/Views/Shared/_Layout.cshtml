<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kingdom Cats Sanctuary</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --cream: #F7F3EA;
            --card: #FFFFFF;
            --ink: #1C1917;
            --red: #C1272D;
            --red-dark: #9E1F24;
            --muted: #78716C;
            --hairline: #E7E1D3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cream);
            color: var(--ink);
            background-image: radial-gradient(circle at 8px 8px, rgba(193,39,45,0.05) 2px, transparent 2.5px), radial-gradient(circle at 22px 6px, rgba(193,39,45,0.05) 2px, transparent 2.5px), radial-gradient(circle at 15px 18px, rgba(193,39,45,0.05) 2px, transparent 2.5px);
            background-size: 60px 60px;
            margin: 0;
        }

        .font-display {
            font-family: 'Playfair Display', serif;
        }

        .btn-primary {
            background-color: var(--red);
            transition: background-color .15s ease, transform .1s ease;
        }

            .btn-primary:hover {
                background-color: var(--red-dark);
            }

            .btn-primary:active {
                transform: scale(0.99);
            }

        input:focus,
        select:focus {
            outline: none;
            border-color: var(--red) !important;
            box-shadow: 0 0 0 3px rgba(193,39,45,0.12);
        }


        /* =========================================================
                   PAGE TRANSITION
                ========================================================= */

        .page-transition {
            position: fixed;
            inset: 0;
            z-index: 100;
            background-color: var(--ink);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform .7s cubic-bezier(.65,0,.35,1);
        }

        .page-transition__mark {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.25rem;
            letter-spacing: .08em;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity .4s ease .15s, transform .4s ease .15s;
            text-align: center;
            padding: 0 1.5rem;
        }

        .page-transition.is-visible .page-transition__mark {
            opacity: 1;
            transform: translateY(0);
        }

        .page-transition.is-leaving {
            transform: translateY(-100%);
        }

        .page-transition.is-done {
            display: none;
        }


        /* =========================================================
                   HAMBURGER
                ========================================================= */

        .hamburger-btn {
            position: fixed;
            top: 1.25rem;
            left: 1.25rem;
            z-index: 60;
            width: 46px;
            height: 46px;
            border-radius: 9999px;
            background-color: var(--ink);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
            border: none;
        }

            .hamburger-btn span {
                display: block;
                width: 20px;
                height: 2px;
                background-color: #fff;
                transition: transform .25s ease, opacity .2s ease;
            }

            .hamburger-btn.open span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .hamburger-btn.open span:nth-child(2) {
                opacity: 0;
            }

            .hamburger-btn.open span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }


        /* =========================================================
                   OVERLAY + NAVIGATION PANEL
                ========================================================= */

        .nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(28,25,23,0.55);
            z-index: 50;
            opacity: 0;
            pointer-events: none;
            transition: opacity .25s ease;
        }

            .nav-overlay.open {
                opacity: 1;
                pointer-events: auto;
            }

        .nav-panel {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 360px;
            max-width: 88vw;
            background-color: var(--ink);
            z-index: 55;
            transform: translateX(-100%);
            transition: transform .3s ease;
            padding: 5.5rem 2.5rem 2rem;
            overflow-y: auto;
        }

            .nav-panel.open {
                transform: translateX(0);
            }


        /* =========================================================
                   LINE SIDEBAR
                ========================================================= */

        .line-sidebar {
            --accent-color: #C1272D;
            --text-color: #c4c4c4;
            --marker-color: #6c6c6c;
            --marker-length: 50px;
            --marker-gap: 0px;
            --tick-scale: 0.5;
            --max-shift: 25px;
            --item-gap: 22px;
            --font-size: 1.15rem;
            --smoothing: 100ms;
            position: relative;
            display: block;
            width: 100%;
        }

        .line-sidebar--markers {
            padding-left: calc(var(--marker-length) + var(--marker-gap));
        }

        .line-sidebar__list {
            list-style: none;
            margin: 0;
            padding: .5rem 0 0;
            display: flex;
            flex-direction: column;
            gap: var(--item-gap);
            width: 100%;
        }

        .line-sidebar__item {
            position: relative;
            cursor: pointer;
        }

            .line-sidebar__item::before {
                content: '';
                position: absolute;
                inset: -5px -40px;
            }

        .line-sidebar__label {
            position: relative;
            display: inline-flex;
            align-items: baseline;
            font-size: var(--font-size);
            font-family: 'Playfair Display', serif;
            line-height: 1.2;
            text-decoration: none;
            color: color-mix( in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--text-color) );
            transform: translateX( calc(var(--effect, 0) * var(--max-shift)) );
            transition: color .15s ease;
        }

        .line-sidebar__index {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            margin-right: .55rem;
            font-size: .72em;
            opacity: calc(.55 + var(--effect, 0) * .45);
        }

        .line-sidebar__marker {
            position: absolute;
            top: 50%;
            left: calc(-1 * var(--marker-length) - var(--marker-gap));
            height: 1px;
            width: var(--marker-length);
            background-color: color-mix( in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--marker-color) );
            transform-origin: left center;
            transform: translateY(-50%) scaleX( calc(.7 + var(--effect, 0) * .5) );
        }

        .line-sidebar--markers
        .line-sidebar__item:not(:last-child)::after {
            content: '';
            position: absolute;
            top: calc(100% + var(--item-gap) / 2);
            left: calc(-1 * var(--marker-length) - var(--marker-gap));
            height: 1px;
            width: calc(var(--marker-length) * var(--tick-scale));
            background-color: var(--marker-color);
            opacity: .5;
            transform: translateY(-50%);
        }


        /* =========================================================
                   PREFERENCES
                   ========================================================= */

        .preference-area {
            margin-top: 2rem;
            padding-top: 1.4rem;
            border-top: 1px solid rgba(255,255,255,.12);
            width: 100%;
        }

        .preference-heading {
            margin: 0 0 1rem 0;
            font-family: 'Playfair Display', serif;
            font-size: .95rem;
            color: rgba(255,255,255,.65);
            letter-spacing: .04em;
        }

        .preference-group {
            margin-bottom: 1rem;
        }

        .preference-label {
            display: block;
            font-size: .68rem;
            font-weight: 600;
            color: rgba(255,255,255,.45);
            margin-bottom: .4rem;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .preference-select {
            width: 100%;
            appearance: none;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 6px;
            background-color: rgba(255,255,255,.055);
            color: #fff;
            padding: .6rem 2.4rem .6rem .75rem;
            font-family: 'Inter', sans-serif;
            font-size: .72rem;
            cursor: pointer;
            background-image: linear-gradient(45deg, transparent 50%, #aaa 50%), linear-gradient(135deg, #aaa 50%, transparent 50%);
            background-position: calc(100% - 15px) 50%, calc(100% - 10px) 50%;
            background-size: 5px 5px, 5px 5px;
            background-repeat: no-repeat;
            transition: border-color .15s ease, background-color .15s ease;
        }

            .preference-select:hover {
                border-color: rgba(255,255,255,.3);
                background-color: rgba(255,255,255,.08);
            }

            .preference-select option {
                background-color: var(--ink);
                color: #fff;
            }

        .preference-note {
            font-size: .58rem;
            color: rgba(255,255,255,.28);
            line-height: 1.5;
            margin: .45rem 0 0;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 400px) {

            .nav-panel {
                width: 320px;
                padding-left: 2rem;
                padding-right: 2rem;
            }

            .line-sidebar {
                --font-size: 1.05rem;
                --item-gap: 19px;
                --marker-length: 42px;
            }

            .preference-select {
                font-size: .68rem;
            }
        }


        @@media (prefers-reduced-motion: reduce) {

            .page-transition,
            .line-sidebar__label,
            .line-sidebar__marker,
            .hamburger-btn span,
            .nav-panel,
            .nav-overlay {
                transition: none !important;
            }
        }
    </style>
</head>

