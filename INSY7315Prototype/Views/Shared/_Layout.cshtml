    <!-- =============================================================
         PAGE TRANSITION
    ============================================================= -->

    <script>

        (function () {

            const overlay =
                document.getElementById(
                    'page-transition'
                );


            if (!overlay) {
                return;
            }


            const prefersReduced =
                window.matchMedia(
                    '(prefers-reduced-motion: reduce)'
                ).matches;


            if (prefersReduced) {

                overlay.classList.add(
                    'is-done'
                );

                return;

            }


            requestAnimationFrame(
                function () {

                    overlay.classList.add(
                        'is-visible'
                    );

                }
            );


            setTimeout(
                function () {

                    overlay.classList.add(
                        'is-leaving'
                    );


                    overlay.addEventListener(
                        'transitionend',
                        function handler(e) {

                            if (
                                e.target !== overlay ||
                                e.propertyName !== 'transform'
                            ) {
                                return;
                            }


                            overlay.classList.add(
                                'is-done'
                            );


                            overlay.removeEventListener(
                                'transitionend',
                                handler
                            );

                        }
                    );

                },
                550
            );

        })();

    </script>


