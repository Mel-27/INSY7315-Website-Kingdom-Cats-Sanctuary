            function applyLanguage(language) {

                const dictionary =
                    translations[language] ||
                    translations.en;


                document
                    .querySelectorAll('[data-i18n]')
                    .forEach(
                        function (element) {

                            const key =
                                element.getAttribute(
                                    'data-i18n'
                                );

                            if (dictionary[key]) {

                                element.textContent =
                                    dictionary[key];

                            }

                        }
                    );


                document.documentElement.lang =
                    language;


                localStorage.setItem(
                    'kks-language',
                    language
                );

            }


            languageSelector.addEventListener(
                'change',
                function () {

                    applyLanguage(
                        languageSelector.value
                    );

                }
            );


            /* =====================================================
               CURRENCY
            ===================================================== */

            const currencySelector =
                document.getElementById(
                    'currency-selector'
                );


            const currencySymbols = {

                ZAR: "R",
                USD: "$",
                GBP: "£",
                EUR: "€",
                AUD: "$",
                CAD: "$",
                NZD: "$",
                INR: "₹",
                AED: "د.إ",
                SAR: "﷼",
                JPY: "¥",
                CNY: "¥",
                SGD: "$",
                BRL: "R$",
                MXN: "$",
                CHF: "Fr"

            };


            function applyCurrency(currency) {

                const option =
                    currencySelector.querySelector(
                        `option[value="${currency}"]`
                    );


                if (!option) {
                    return;
                }


                const country =
                    option.dataset.country;

                const rate =
                    parseFloat(
                        option.dataset.rate
                    );

                const symbol =
                    currencySymbols[currency] ||
                    currency;


                /*
                 * Store the selected currency globally.
                 */

                window.KKSCurrency = {

                    code: currency,
                    symbol: symbol,
                    country: country,
                    rate: rate

                };


                /*
                 * Convert every element that
                 * contains data-price.
                 */

                document
                    .querySelectorAll('[data-price]')
                    .forEach(
                        function (element) {

                            const basePrice =
                                parseFloat(
                                    element.dataset.price
                                );


                            if (isNaN(basePrice)) {
                                return;
                            }


                            const converted =
                                basePrice * rate;


                            element.textContent =
                                `${symbol}${converted.toFixed(2)}`;

                        }
                    );


                localStorage.setItem(
                    'kks-currency',
                    currency
                );


                /*
                 * Tell the rest of the website
                 * that the currency changed.
                 */

                window.dispatchEvent(
                    new CustomEvent(
                        'currencyChanged',
                        {
                            detail:
                                window.KKSCurrency
                        }
                    )
                );

            }


            currencySelector.addEventListener(
                'change',
                function () {

                    applyCurrency(
                        currencySelector.value
                    );

                }
            );


            /* =====================================================
               RESTORE SAVED LANGUAGE
            ===================================================== */

            const savedLanguage =
                localStorage.getItem(
                    'kks-language'
                );


            if (
                savedLanguage &&
                languageSelector.querySelector(
                    `option[value="${savedLanguage}"]`
                )
            ) {

                languageSelector.value =
                    savedLanguage;

            }


            /* =====================================================
               RESTORE SAVED CURRENCY
            ===================================================== */

            const savedCurrency =
                localStorage.getItem(
                    'kks-currency'
                );


            if (
                savedCurrency &&
                currencySelector.querySelector(
                    `option[value="${savedCurrency}"]`
                )
            ) {

                currencySelector.value =
                    savedCurrency;

            }


            /* =====================================================
               INITIALISE
            ===================================================== */

            applyLanguage(
                languageSelector.value
            );


            applyCurrency(
                currencySelector.value
            );

        })();

