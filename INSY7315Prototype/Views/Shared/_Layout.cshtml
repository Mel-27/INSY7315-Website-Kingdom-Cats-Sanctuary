<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kingdom Cats Sanctuary</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --cream: #F7F3EA;
            --card: #FFFFFF;
            --ink: #1C1917;
            --red: #C1272D;
            --red-dark: #9E1F24;
            --muted: #78716C;
            --hairline: #E7E1D3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter',sans-serif;
            background-color: var(--cream);
            color: var(--ink);
            background-image: radial-gradient(circle at 8px 8px, rgba(193,39,45,0.05) 2px, transparent 2.5px), radial-gradient(circle at 22px 6px, rgba(193,39,45,0.05) 2px, transparent 2.5px), radial-gradient(circle at 15px 18px, rgba(193,39,45,0.05) 2px, transparent 2.5px);
            background-size: 60px 60px;
            margin: 0;
        }

        .font-display {
            font-family: 'Playfair Display', serif;
        }

        .btn-primary {
            background-color: var(--red);
            transition: background-color .15s ease, transform .1s ease;
        }

            .btn-primary:hover {
                background-color: var(--red-dark);
            }

            .btn-primary:active {
                transform: scale(0.99);
            }

        input:focus {
            outline: none;
            border-color: var(--red) !important;
            box-shadow: 0 0 0 3px rgba(193,39,45,0.12);
        }

        .tab-btn {
            position: relative;
            color: var(--muted);
            transition: color .15s ease;
        }

            .tab-btn.active {
                color: var(--ink);
            }

        .tab-underline {
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 2px;
            background-color: var(--red);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s ease;
        }

        .tab-btn.active .tab-underline {
            transform: scaleX(1);
        }

        .field-panel {
            transition: opacity .2s ease;
        }

        @@media (prefers-reduced-motion: reduce) {
            .btn-primary, .tab-underline, .field-panel {
                transition: none !important;
            }
        }
    </style>
</head>

<!-- Navigation Bar -->

<ul class="navbar-nav ms-auto">
    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
</ul>

<body>
    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>