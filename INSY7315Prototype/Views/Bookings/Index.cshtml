@model INSY7315Prototype.Models.BookingPageViewModel
@{
    ViewData["Title"] = "Book a Session(Adopt or Relax)";
    var dayHeaders = new[] { "S", "M", "T", "W", "T", "F", "S" };
}

<style>
    .flip-fade-text {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        perspective: 1000px;
    }

    .flip-fade-letter {
        display: inline-block;
        transform-style: preserve-3d;
        opacity: 0;
        transform: rotateX(90deg) translateY(20px);
        filter: blur(8px);
        animation: flipFadeIn 0.6s cubic-bezier(0.2, 0.65, 0.3, 0.9) forwards;
    }

    @@keyframes flipFadeIn {
        to {
            opacity: 1;
            transform: rotateX(0deg) translateY(0);
            filter: blur(0px);
        }
    }
</style>
<section class="max-w-4xl mx-auto px-6 md:px-12 py-10">

    <h1 class="flip-fade-text font-display text-3xl mb-2">
        @(Model.CatId.HasValue ? $"Book a viewing with {Model.CatName}" : "Kitten Petting Sessions")
    </h1>
    

    <!-- Image collage effect -->
    <style>
        .collage-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.75rem;
            width: 100%;
            min-height: 300px;
            margin-bottom: 3rem;
        }

        .collage-stage {
            position: relative;
            height: 11rem;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .collage-img {
            position: absolute;
            width: 7.5rem;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            border-radius: 0.75rem;
            opacity: 0;
            transform: scale(0.6) translate(0, 40px) rotate(0deg);
            transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease;
            box-shadow: 0 12px 28px -8px rgba(0,0,0,0.28);
            border: 3px solid var(--card, #fff);
        }

            /* staggered entrance delays */
            .collage-img:nth-child(1) {
                transition-delay: 0s;
            }

            .collage-img:nth-child(2) {
                transition-delay: 0.1s;
            }

            .collage-img:nth-child(3) {
                transition-delay: 0.2s;
            }

            .collage-img:nth-child(4) {
                transition-delay: 0.3s;
            }

            .collage-img:nth-child(5) {
                transition-delay: 0.4s;
            }

        .collage-stage.is-loaded .collage-img {
            opacity: 1;
        }

        /* gentle continuous float once settled, each on its own rhythm */
        .collage-stage.is-floating .collage-img {
            animation: catFloat 4.5s ease-in-out infinite;
        }

            .collage-stage.is-floating .collage-img:nth-child(1) {
                animation-delay: 0s;
            }

            .collage-stage.is-floating .collage-img:nth-child(2) {
                animation-delay: 0.6s;
            }

            .collage-stage.is-floating .collage-img:nth-child(3) {
                animation-delay: 1.2s;
            }

            .collage-stage.is-floating .collage-img:nth-child(4) {
                animation-delay: 1.8s;
            }

            .collage-stage.is-floating .collage-img:nth-child(5) {
                animation-delay: 2.4s;
            }

        @@keyframes catFloat {
            0%, 100% {
                translate: 0 0;
            }

            50% {
                translate: 0 -8px;
            }
        }

        .collage-caption {
            text-align: center;
            max-width: 34rem;
        }

            .collage-caption h2 {
                font-family: var(--font-display, inherit);
                font-size: 1.35rem;
                margin-bottom: 0.5rem;
                color: var(--ink, inherit);
            }

            .collage-caption p {
                font-size: 0.9rem;
                line-height: 1.6;
                color: var(--muted);
            }
    </style>

    <div class="collage-wrap" id="cat-collage">
        <div class="collage-stage" id="collage-stage">
            <img class="collage-img" data-x="-150" data-y="-12" data-rotate="-12"
                 src="/images/catTwo.jpeg" alt="Sanctuary cat" />
            <img class="collage-img" data-x="-75" data-y="18" data-rotate="8"
                 src="/images/catSeven.jpeg" alt="Sanctuary cat" />
            <img class="collage-img" data-x="0" data-y="-28" data-rotate="-4"
                 src="/images/catThree.jpeg" alt="Sanctuary cat" />
            <img class="collage-img" data-x="75" data-y="18" data-rotate="10"
                 src="/images/catTen.jpeg" alt="Sanctuary cat" />
            <img class="collage-img" data-x="150" data-y="-8" data-rotate="-8"
                 src="/images/catNine.jpeg" alt="Sanctuary cat" />
        </div>
        <div class="collage-caption">
            <h2>Meet your future best friend</h2>
            <p>
                Meet your furry baby in person before deciding to adopt.
                Every one of our residents is looking for a lap to curl up in.
                Book a kitten petting session to say hello, or schedule an
                adoption viewing to spend real one-on-one time with a cat you've
                fallen for. No pressure, just purrs!
            </p>
        </div>
    </div>


    <div class="grid md:grid-cols-2 gap-8">

        <!-- Calendar -->
        <div>
            <h2 class="font-semibold text-sm uppercase tracking-wide mb-3">1. Select a date</h2>
            <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-4">

                <div class="flex items-center justify-between mb-3">
                    @if (Model.CanGoPrev)
                    {
                        <a asp-action="Index" asp-route-catId="@Model.CatId" asp-route-month="@Model.PrevMonth" asp-route-year="@Model.PrevYear" class="text-sm px-2">&larr;</a>
                    }
                    else
                    {
                        <span class="text-sm px-2 opacity-30">&larr;</span>
                    }
                    <p class="font-display text-lg">@Model.MonthName</p>
                    <a asp-action="Index" asp-route-catId="@Model.CatId" asp-route-month="@Model.NextMonth" asp-route-year="@Model.NextYear" class="text-sm px-2">&rarr;</a>
                </div>

                <div class="grid grid-cols-7 gap-1 text-center text-[10px] text-[var(--muted)] uppercase mb-2">
                    @foreach (var h in dayHeaders)
                    {
                        <span>@h</span>
                    }
                </div>

                <div id="calendar-days" class="grid grid-cols-7 gap-1" data-month="@Model.Month" data-year="@Model.Year">
                    @foreach (var week in Model.CalendarWeeks)
                    {
                        foreach (var day in week)
                        {
                            if (day.HasValue)
                            {
                                var isPast = new DateTime(Model.Year, Model.Month, day.Value) < DateTime.Today;
                                <button type="button"
                                        class="calendar-day text-sm rounded-lg py-2 @(isPast ? "opacity-30 cursor-not-allowed" : "hover:bg-[var(--hairline)]/50")"
                                        data-day="@day"
                                        @(isPast ? "disabled" : "")>
                                    @day
                                </button>
                            }
                            else
                            {
                                <span></span>
                            }
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Time slots -->
        <div>
            <h2 class="font-semibold text-sm uppercase tracking-wide mb-3">2. Choose a time</h2>
            <div class="space-y-2">
                @foreach (var slot in Model.TimeSlots)
                {
                    <button type="button"
                            class="time-slot w-full flex items-center justify-between px-4 py-3 rounded-lg border border-[var(--hairline)] bg-[var(--card)] text-sm @(slot.IsFullyBooked ? "opacity-40 cursor-not-allowed" : "hover:border-[var(--red)]")"
                            data-label="@slot.Label"
                            data-range="@slot.TimeRange"
                            @(slot.IsFullyBooked ? "disabled" : "")>
                        <span class="font-medium">@slot.Label</span>
                        <span class="text-[var(--muted)]">@slot.TimeRange</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Review + confirm -->
    <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-6 mt-8">
        <h2 class="font-semibold text-sm uppercase tracking-wide mb-4">3. Review your booking</h2>

        <div class="grid sm:grid-cols-3 gap-4 mb-6 text-sm">
            <div>
                <p class="text-[10px] uppercase text-[var(--muted)] mb-1">Session type</p>
                <p class="font-medium">@(Model.CatId.HasValue ? $"Viewing — {Model.CatName}" : "Kitten petting session")</p>
            </div>
            <div>
                <p class="text-[10px] uppercase text-[var(--muted)] mb-1">Date &amp; time</p>
                <p id="review-datetime" class="font-medium text-[var(--muted)]">Not selected yet</p>
            </div>
            
        </div>

        <form id="booking-form" asp-controller="Bookings" asp-action="Create" method="post" class="space-y-4">
            <input type="hidden" name="CatId" value="@Model.CatId" />
            <input type="hidden" name="BookingDate" id="input-date" />
            <input type="hidden" name="TimeSlot" id="input-timeslot" />
            <input type="hidden" name="DonationAmount" value="25" />

            <div class="grid sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Your full name</label>
                    <input name="ParticipantName" type="text" required
                           class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Email address</label>
                    <input name="ParticipantEmail" type="email" required
                           class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
                </div>
            </div>

            <button type="submit" class="btn-primary w-full text-white text-sm font-semibold tracking-[0.15em] uppercase rounded-lg py-3">
                Confirm &amp; book
            </button>

          
        </form>
    </div>
</section>

@section Scripts {


    <!-- Flip Fade Text animation -->
    <script>
        function animateFlipFadeText(selector, staggerDelay = 0.04) {
            document.querySelectorAll(selector).forEach(function (el) {
                const text = el.textContent;
                el.setAttribute('aria-label', text); // keep it accessible to screen readers
                el.textContent = '';
                [...text].forEach(function (char, i) {
                    const span = document.createElement('span');
                    span.className = 'flip-fade-letter';
                    span.style.animationDelay = (i * staggerDelay) + 's';
                    span.textContent = char === ' ' ? '\u00A0' : char;
                    el.appendChild(span);
                });
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            animateFlipFadeText('.flip-fade-text');
        });
    </script>


    <!-- Image animation effect -->
    <script>
        (function () {
            const stage = document.getElementById('collage-stage');
            if (!stage) return;

            const imgs = stage.querySelectorAll('.collage-img');

            function applyScatter() {
                imgs.forEach(function (img) {
                    const x = img.dataset.x + 'px';
                    const y = img.dataset.y + 'px';
                    const r = img.dataset.rotate + 'deg';
                    img.style.transform = `scale(1) translate(${x}, ${y}) rotate(${r})`;
                });
            }

            // Start the entrance animation immediately on load, no interaction needed
            requestAnimationFrame(function () {
                applyScatter();
                stage.classList.add('is-loaded');
            });

            // Once the entrance transition settles, start the gentle idle float
            setTimeout(function () {
                stage.classList.add('is-floating');
            }, 1200);
        })();
    </script>

    <script>
        const calendarContainer = document.getElementById('calendar-days');
        const month = parseInt(calendarContainer.dataset.month);
        const year = parseInt(calendarContainer.dataset.year);

        let selectedDay = null;
        let selectedSlot = null;

        function updateReview() {
            const el = document.getElementById('review-datetime');
            if (selectedDay && selectedSlot) {
                el.textContent = `${month}/${selectedDay}/${year}, ${selectedSlot}`;
                el.classList.remove('text-[var(--muted)]');
            } else {
                el.textContent = 'Not selected yet';
            }
        }

        document.querySelectorAll('.calendar-day:not([disabled])').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.calendar-day').forEach(b => b.classList.remove('bg-[var(--ink)]', 'text-white'));
                this.classList.add('bg-[var(--ink)]', 'text-white');

                selectedDay = this.getAttribute('data-day');
                const iso = `${year}-${String(month).padStart(2, '0')}-${String(selectedDay).padStart(2, '0')}`;
                document.getElementById('input-date').value = iso;

                updateReview();
            });
        });

        document.querySelectorAll('.time-slot:not([disabled])').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.time-slot').forEach(b => b.classList.remove('border-[var(--red)]', 'bg-[var(--red)]/5'));
                this.classList.add('border-[var(--red)]', 'bg-[var(--red)]/5');

                const label = this.getAttribute('data-label');
                const range = this.getAttribute('data-range');
                selectedSlot = `${label} (${range})`;
                document.getElementById('input-timeslot').value = selectedSlot;

                updateReview();
            });
        });

        document.getElementById('booking-form').addEventListener('submit', function (e) {
            if (!document.getElementById('input-date').value || !document.getElementById('input-timeslot').value) {
                e.preventDefault();
                alert('Please select a date and time before confirming your booking.');
            }
        });
    </script>
}
