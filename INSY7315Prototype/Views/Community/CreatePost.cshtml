@{
    ViewData["Title"] = "Share a Story";
}

<section class="max-w-2xl mx-auto px-6 md:px-12 pt-28 pb-16">

    <a asp-controller="Community" asp-action="Index" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--muted)] hover:text-[var(--red)] transition-colors mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to community
    </a>

    <h1 class="font-display text-3xl mb-2">Share a story</h1>
    <p class="text-sm text-[var(--muted)] mb-8">
        Tell fellow adopters, donors, and volunteers what's happening &mdash; an adoption update, a foster milestone, or just a good day at the sanctuary.
    </p>

    @if (TempData["PostError"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-6">
            @TempData["PostError"]
        </div>
    }

    <div class="bg-[var(--card)] rounded-2xl border border-[var(--hairline)] p-6 md:p-8">
        <form asp-controller="Community" asp-action="CreatePost" method="post" enctype="multipart/form-data" class="space-y-5">

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Your name</label>
                <input name="AuthorName" type="text" required placeholder="e.g. Thandiwe Ngcobo"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Caption</label>
                <textarea name="Caption" rows="5" required placeholder="What's happening?"
                          class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm resize-none"></textarea>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">
                    Photo <span class="text-[var(--muted)] normal-case font-normal">(optional)</span>
                </label>
                <label for="photo-upload" class="flex flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-8 text-center cursor-pointer hover:border-[var(--red)] transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[var(--muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                    <span class="text-sm text-[var(--muted)]">
                        <span class="font-semibold text-[var(--red)]">Click to upload</span> or drag and drop
                    </span>
                    <span class="text-xs text-[var(--muted)]">PNG or JPEG</span>
                    <input id="photo-upload" name="PhotoFile" type="file" accept="image/png, image/jpeg" class="sr-only">
                </label>
                <p id="photo-upload-filename" class="text-xs text-[var(--muted)] mt-2 hidden"></p>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">
                    Tags <span class="text-[var(--muted)] normal-case font-normal">(comma separated, optional)</span>
                </label>
                <input name="TagsInput" type="text" placeholder="AdoptionSuccess, NewBeginnings"
                       class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="btn-primary text-white text-sm font-semibold tracking-[0.15em] uppercase rounded-lg px-6 py-3">
                    Post to community
                </button>
                <a asp-controller="Community" asp-action="Index" class="text-sm font-semibold text-[var(--muted)] hover:text-[var(--red)] transition-colors">
                    Cancel
                </a>
            </div>

        </form>
    </div>

</section>

<script>
    (function () {
        const input = document.getElementById('photo-upload');
        const filenameEl = document.getElementById('photo-upload-filename');
        if (!input || !filenameEl) return;

        input.addEventListener('change', function () {
            if (input.files && input.files.length > 0) {
                filenameEl.textContent = 'Selected: ' + input.files[0].name;
                filenameEl.classList.remove('hidden');
            } else {
                filenameEl.classList.add('hidden');
            }
        });
    })();
</script>
