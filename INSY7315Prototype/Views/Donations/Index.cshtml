@model INSY7315Prototype.Models.Donation
@{
    ViewData["Title"] = "Donate";
}

<style>
    .flip-fade-text {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        perspective: 1000px;
    }

    .flip-fade-letter {
        display: inline-block;
        transform-style: preserve-3d;
        opacity: 0;
        transform: rotateX(90deg) translateY(20px);
        filter: blur(8px);
        animation: flipFadeIn 0.6s cubic-bezier(0.2, 0.65, 0.3, 0.9) forwards;
    }

    @@keyframes flipFadeIn {
        to {
            opacity: 1;
            transform: rotateX(0deg) translateY(0);
            filter: blur(0px);
        }
    }

    .donation-method-card {
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

        .donation-method-card.selected {
            border-color: var(--red);
            background-color: color-mix(in srgb, var(--red) 6%, transparent);
        }

    .amount-chip {
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

        .amount-chip.selected {
            border-color: var(--red);
            background-color: color-mix(in srgb, var(--red) 8%, transparent);
            color: var(--red);
            font-weight: 600;
        }

    .donate-highlight-icon {
        width: 18px;
        height: 18px;
        stroke: var(--red);
        flex-shrink: 0;
    }

    /* Step section blocks */
    .step-block {
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid var(--hairline);
    }

    .step-block-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem;
        background: #000000;
        color: #ffffff;
        border-bottom: 1px solid var(--hairline);
    }

    .step-block-body {
        background: var(--card);
        padding: 1.5rem;
    }

    .step-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        min-width: 26px;
        border-radius: 999px;
        background: var(--red);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

    /* Full-width header banner */
    .header-banner {
        width: 100%;
        background: linear-gradient(90deg, color-mix(in srgb, var(--red) 12%, var(--cream)) 0%, color-mix(in srgb, var(--red) 4%, var(--cream)) 100%);
        border-bottom: 1px solid var(--hairline);
    }

    .header-banner-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 3.5rem 1.5rem;
    }

    .header-banner-title {
        text-align: left;
        max-width: 28rem;
    }

    .header-banner-intro {
        margin-top: 0.75rem;
    }

    .header-banner-highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: center;
    }

    .header-banner-highlight {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }
</style>

<!-- Page header banner -->
<section class="header-banner">
    <div class="max-w-6xl mx-auto px-6 header-banner-inner">
        <div class="header-banner-title">
            <span class="inline-block text-[10px] font-semibold uppercase tracking-[0.25em] text-[var(--red)] mb-1">
                Make a difference today
            </span>
            <h1 class="flip-fade-text font-display text-2xl sm:text-3xl">Support the Sanctuary</h1>
            <p class="header-banner-intro text-[var(--muted)] text-sm">
                Every donation helps feed, shelter, and care for our cats until they find their forever homes —
                every contribution, big or small, makes a real difference.
            </p>
        </div>

        <div class="header-banner-highlights">
            <div class="header-banner-highlight">
                <svg class="donate-highlight-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a3 3 0 100-6 3 3 0 000 6zM4.5 9.75a2.25 2.25 0 114.5 0 2.25 2.25 0 01-4.5 0zM15 9.75a2.25 2.25 0 114.5 0 2.25 2.25 0 01-4.5 0zM7.5 16.5c0-2.485 2.015-4.5 4.5-4.5s4.5 2.015 4.5 4.5v1.125c0 .621-.504 1.125-1.125 1.125h-6.75A1.125 1.125 0 017.5 17.625V16.5z" />
                </svg>
                <span class="text-xs font-semibold uppercase tracking-wide">Food &amp; Care</span>
            </div>

            <div class="header-banner-highlight">
                <svg class="donate-highlight-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.5 1.5 0 012.122 0L22.28 12M4.5 9.75V21a.75.75 0 00.75.75H9.75v-6a.75.75 0 01.75-.75h3a.75.75 0 01.75.75v6h4.5a.75.75 0 00.75-.75V9.75" />
                </svg>
                <span class="text-xs font-semibold uppercase tracking-wide">Shelter &amp; Comfort</span>
            </div>

            <div class="header-banner-highlight">
                <svg class="donate-highlight-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
                <span class="text-xs font-semibold uppercase tracking-wide">Rehoming Support</span>
            </div>
        </div>
    </div>
</section>

<section class="max-w-3xl mx-auto px-6 py-16">

    @if (TempData["DonationError"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-6">
            @TempData["DonationError"]
        </div>
    }

    <form id="donation-form" asp-controller="Donations" asp-action="Create" method="post" class="space-y-6">

        <!-- Amount -->
        <div class="step-block">
            <div class="step-block-header">
                <span class="step-number">1</span>
                <h2 class="font-semibold text-sm uppercase tracking-wide">Choose an amount</h2>
            </div>
            <div class="step-block-body">
                <div class="flex flex-wrap gap-2" id="amount-chips">
                    <button type="button" class="amount-chip px-4 py-2 rounded-lg border border-[var(--hairline)] bg-[var(--card)] text-sm" data-amount="50">R50</button>
                    <button type="button" class="amount-chip px-4 py-2 rounded-lg border border-[var(--hairline)] bg-[var(--card)] text-sm" data-amount="100">R100</button>
                    <button type="button" class="amount-chip px-4 py-2 rounded-lg border border-[var(--hairline)] bg-[var(--card)] text-sm" data-amount="250">R250</button>
                    <button type="button" class="amount-chip px-4 py-2 rounded-lg border border-[var(--hairline)] bg-[var(--card)] text-sm" data-amount="500">R500</button>
                    <input type="number" min="10" step="1" id="custom-amount" placeholder="Custom amount"
                           class="px-4 py-2 rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 text-sm w-36" />
                </div>
                <input type="hidden" name="Amount" id="input-amount" />
            </div>
        </div>

        <!-- Payment method -->
        <div class="step-block">
            <div class="step-block-header">
                <span class="step-number">2</span>
                <h2 class="font-semibold text-sm uppercase tracking-wide">Choose a payment method</h2>
            </div>
            <div class="step-block-body">
                <div class="grid sm:grid-cols-2 gap-4">

                    <div class="donation-method-card border border-[var(--hairline)] bg-[var(--card)] rounded-2xl p-5" data-method="PayPal">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-medium">PayPal</span>
                            <span class="text-[10px] uppercase tracking-wide text-[var(--muted)]">Card / PayPal balance</span>
                        </div>
                        <p class="text-xs text-[var(--muted)]">
                            Pay securely using your PayPal account or any major card, no PayPal account required.
                        </p>
                    </div>

                    <div class="donation-method-card border border-[var(--hairline)] bg-[var(--card)] rounded-2xl p-5" data-method="Ozow">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-medium">Ozow</span>
                            <span class="text-[10px] uppercase tracking-wide text-[var(--muted)]">Instant EFT</span>
                        </div>
                        <p class="text-xs text-[var(--muted)]">
                            Pay directly from your South African bank account via secure instant EFT.
                        </p>
                    </div>

                </div>
                <input type="hidden" name="PaymentMethod" id="input-method" />
            </div>
        </div>

        <!-- Donor details -->
        <div class="step-block">
            <div class="step-block-header">
                <span class="step-number">3</span>
                <h2 class="font-semibold text-sm uppercase tracking-wide">Your details</h2>
            </div>
            <div class="step-block-body">
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Full name</label>
                        <input name="DonorName" type="text" required
                               class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5">Email address</label>
                        <input name="DonorEmail" type="email" required
                               class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--cream)]/40 px-4 py-2.5 text-sm">
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary w-full text-white text-sm font-semibold tracking-[0.15em] uppercase rounded-lg py-3">
            Continue to donate
        </button>

    </form>
</section>

<!-- Item donations -->
<section class="w-full bg-[var(--cream)]/50 border-t border-[var(--hairline)]">
    <div class="max-w-5xl mx-auto px-6 py-16">
        <h2 class="font-display text-2xl text-center mb-2">Prefer to donate items?</h2>
        <p class="text-[var(--muted)] text-sm max-w-xl mx-auto text-center mb-10">
            Physical supplies keep the sanctuary running day to day. Here's what we always need — drop off at the sanctuary, or
            <a asp-controller="Contact" asp-action="Index" class="text-[var(--red)] font-medium hover:text-[var(--red-dark)]">contact us</a>
            to arrange collection.
        </p>

        <div class="grid sm:grid-cols-2 gap-6">

            <div class="bg-[var(--card)] rounded-2xl border border-[var(--hairline)] overflow-hidden">
                <div class="aspect-video overflow-hidden">
                    <img src="~/images/Equipment.jpeg" alt="Equipment donations" class="w-full h-full object-cover">
                </div>
                <div class="p-5">
                    <h3 class="font-semibold mb-1">Equipment</h3>
                    <p class="text-sm text-[var(--muted)]">Carriers, scratching posts, litter boxes, and general sanctuary equipment.</p>
                </div>
            </div>

            <div class="bg-[var(--card)] rounded-2xl border border-[var(--hairline)] overflow-hidden">
                <div class="aspect-video overflow-hidden">
                    <img src="~/images/catToys.jpeg" alt="Toys and blankets donations" class="w-full h-full object-cover">
                </div>
                <div class="p-5">
                    <h3 class="font-semibold mb-1">Toys &amp; blankets</h3>
                    <p class="text-sm text-[var(--muted)]">Soft blankets, cat toys, and scratching pads — comfort and play for our residents.</p>
                </div>
            </div>

            <div class="bg-[var(--card)] rounded-2xl border border-[var(--hairline)] overflow-hidden">
                <div class="aspect-video overflow-hidden">
                    <img src="~/images/food.jpeg" alt="Cat food and litter donations" class="w-full h-full object-cover">
                </div>
                <div class="p-5">
                    <h3 class="font-semibold mb-1">Food &amp; litter</h3>
                    <p class="text-sm text-[var(--muted)]">Dry and wet cat food, plus clumping litter, to keep every resident fed and their spaces clean.</p>
                </div>
            </div>

            <div class="bg-[var(--card)] rounded-2xl border border-[var(--hairline)] overflow-hidden">
                <div class="aspect-video overflow-hidden">
                    <img src="~/images/cleaningSupplies.jpeg" alt="Cleaning supplies donations" class="w-full h-full object-cover">
                </div>
                <div class="p-5">
                    <h3 class="font-semibold mb-1">Cleaning supplies</h3>
                    <p class="text-sm text-[var(--muted)]">Floor disinfectant, mops, buckets, and sponges to help keep the sanctuary spotless.</p>
                </div>
            </div>

        </div>
    </div>
</section>



@section Scripts {
    <script>
        function animateFlipFadeText(selector, staggerDelay = 0.04) {
            document.querySelectorAll(selector).forEach(function (el) {
                const text = el.textContent;
                el.setAttribute('aria-label', text);
                el.textContent = '';
                [...text].forEach(function (char, i) {
                    const span = document.createElement('span');
                    span.className = 'flip-fade-letter';
                    span.style.animationDelay = (i * staggerDelay) + 's';
                    span.textContent = char === ' ' ? '\u00A0' : char;
                    el.appendChild(span);
                });
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            animateFlipFadeText('.flip-fade-text');
        });
    </script>

    <script>
        const amountInput = document.getElementById('input-amount');
        const customAmount = document.getElementById('custom-amount');

        document.querySelectorAll('.amount-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                document.querySelectorAll('.amount-chip').forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');
                customAmount.value = '';
                amountInput.value = this.getAttribute('data-amount');
            });
        });

        customAmount.addEventListener('input', function () {
            document.querySelectorAll('.amount-chip').forEach(c => c.classList.remove('selected'));
            amountInput.value = this.value;
        });

        const methodInput = document.getElementById('input-method');
        document.querySelectorAll('.donation-method-card').forEach(function (card) {
            card.addEventListener('click', function () {
                document.querySelectorAll('.donation-method-card').forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');
                methodInput.value = this.getAttribute('data-method');
            });
        });

        document.getElementById('donation-form').addEventListener('submit', function (e) {
            if (!amountInput.value || Number(amountInput.value) <= 0) {
                e.preventDefault();
                alert('Please select or enter a donation amount.');
                return;
            }
            if (!methodInput.value) {
                e.preventDefault();
                alert('Please choose a payment method.');
            }
        });
    </script>
}
