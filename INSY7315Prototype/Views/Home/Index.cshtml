<!-- Community Blog (KCS) -->
<section class="bg-[var(--ink)] text-white py-12 mt-4">
    <div class="max-w-6xl mx-auto px-6 md:px-12 text-center">
        <h2 class="font-display text-2xl mb-3">Join the Kingdom Cats Sanctuary community</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-6 text-sm">
            Follow adoption stories, share cat tips, and help reunite lost cats with their families.
        </p>
        <a asp-controller="Community" asp-action="Index"
           class="inline-block btn-primary text-white text-sm font-semibold tracking-[0.1em] uppercase rounded-lg px-6 py-3">
            Visit the community feed
        </a>
    </div>
</section>

