@model List<INSY7315Prototype.Models.Cat>
@{
    ViewData["Title"] = "Adopt";
}

<section class="max-w-6xl mx-auto px-6 md:px-12 py-10">

    <div class="flex items-center justify-between mb-2">
        <h1 class="font-display text-3xl">Find your companion</h1>
       
    </div>
    <p class="text-[var(--muted)] text-sm max-w-2xl mb-6">
        Our sanctuary is home to gentle souls seeking their forever families. Every adoption saves a life and brings warmth to a home.
    </p>

    <!-- Filter pills -->
    <div id="filter-pills" class="flex flex-wrap gap-2 mb-8">
        <button data-filter="All" class="filter-pill active px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wide">
            All Residents
        </button>
        <button data-filter="Kitten" class="filter-pill px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wide">
            Kittens
        </button>
        <button data-filter="Senior" class="filter-pill px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wide">
            Senior Cats
        </button>
        <button data-filter="SpecialNeeds" class="filter-pill px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wide">
            Special Needs
        </button>
    </div>

    <!-- Cat grid -->
    <div id="cat-grid" class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        @foreach (var cat in Model)
        {
            <div class="cat-card bg-[var(--card)] rounded-2xl border border-[var(--hairline)] overflow-hidden" data-category="@cat.Category">

                <div class="aspect-square bg-[var(--hairline)]/40 relative overflow-hidden">
                    @if (!string.IsNullOrEmpty(cat.Badge))
                    {
                        <span class="absolute top-3 right-3 z-10 bg-[var(--ink)] text-white text-[10px] tracking-wide uppercase px-2 py-1 rounded-full">
                            @cat.Badge
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(cat.PhotoUrl))
                    {
                        <img src="@cat.PhotoUrl" alt="@cat.Name" class="w-full h-full object-cover">
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center">
                            <p class="text-xs text-[var(--muted)] uppercase tracking-wide">No photo yet</p>
                        </div>
                    }
                </div>

                <div class="p-4">
                    <div class="flex items-center justify-between mb-1">
                        <h3 class="font-semibold">@cat.Name</h3>
                        <button aria-label="Save @cat.Name" class="text-[var(--muted)] hover:text-[var(--red)]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 10-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z" />
                            </svg>
                        </button>
                    </div>
                    <p class="text-xs text-[var(--muted)] mb-3">@cat.AgeDisplay &middot; @cat.Gender</p>

                    <div class="flex flex-wrap gap-1.5 mb-4">
                        @foreach (var tag in cat.Tags)
                        {
                            <span class="bg-[var(--red)]/10 text-[var(--red)] text-[10px] font-medium px-2 py-1 rounded-full">@tag</span>
                        }
                    </div>

                    <a asp-controller="Cats" asp-action="Details" asp-route-id="@cat.Id"
                       class="block text-center btn-primary text-white text-xs font-semibold tracking-wide uppercase rounded-lg py-2">
                        Book a viewing
                    </a>
                </div>
            </div>
        }
    </div>

    <p id="no-results" class="hidden text-center text-sm text-[var(--muted)] py-12">
        No cats match this filter right now — check back soon!
    </p>
</section>

<style>
    .filter-pill {
        background-color: var(--card);
        border: 1px solid var(--hairline);
        color: var(--muted);
        transition: background-color .15s ease, color .15s ease;
    }

        .filter-pill.active {
            background-color: var(--ink);
            color: white;
            border-color: var(--ink);
        }
</style>

@section Scripts {
    <script>
        document.querySelectorAll('.filter-pill').forEach(function (pill) {
            pill.addEventListener('click', function () {
                document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');
                const cards = document.querySelectorAll('.cat-card');
                let visibleCount = 0;

                cards.forEach(function (card) {
                    const matches = filter === 'All' || card.getAttribute('data-category') === filter;
                    card.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });

                document.getElementById('no-results').classList.toggle('hidden', visibleCount > 0);
            });
        });
    </script>
}
