@{
    ViewData["Title"] = "Manage Users";
}

<div class="min-h-screen bg-[var(--cream)]">

    <div class="max-w-7xl mx-auto px-6 md:px-10 py-10">

        <a href="/Admin/Dashboard"
           class="text-xs font-semibold text-[var(--muted)] hover:text-[var(--red)]">
            ← Admin Dashboard
        </a>

        <div class="mt-4 mb-8">

            <h1 class="font-display text-3xl">
                Users
            </h1>

            <p class="text-sm text-[var(--muted)] mt-2">
                Manage registered Kingdom Cats Sanctuary accounts.
            </p>

        </div>

        <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full text-sm">

                    <thead class="bg-[var(--cream)]/50 border-b border-[var(--hairline)]">

                        <tr>

                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">
                                User
                            </th>

                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">
                                Email
                            </th>

                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">
                                Role
                            </th>

                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">
                                Status
                            </th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody class="divide-y divide-[var(--hairline)]">

                        <tr>

                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">

                                    <div class="w-9 h-9 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center font-semibold">
                                        G
                                    </div>

                                    <span class="font-semibold">
                                        Gia Gounden
                                    </span>

                                </div>
                            </td>

                            <td class="px-6 py-5 text-[var(--muted)]">
                                gia@example.com
                            </td>

                            <td class="px-6 py-5">
                                User
                            </td>

                            <td class="px-6 py-5">
                                <span class="status status-confirmed">
                                    Active
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right">
                                <button class="text-xs font-semibold text-[var(--red)]">
                                    Manage
                                </button>
                            </td>

                        </tr>

                        <tr>

                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">

                                    <div class="w-9 h-9 rounded-full bg-[var(--ink)] text-white flex items-center justify-center font-semibold">
                                        A
                                    </div>

                                    <span class="font-semibold">
                                        Admin
                                    </span>

                                </div>
                            </td>

                            <td class="px-6 py-5 text-[var(--muted)]">
                                admin@kingdomcats.org
                            </td>

                            <td class="px-6 py-5">
                                <span class="text-xs font-semibold text-[var(--red)]">
                                    Admin
                                </span>
                            </td>

                            <td class="px-6 py-5">
                                <span class="status status-confirmed">
                                    Active
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right">
                                <button class="text-xs font-semibold text-[var(--red)]">
                                    Manage
                                </button>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>