@{
    ViewData["Title"] = "Manage Donations";
}

<div class="min-h-screen bg-[var(--cream)]">

    <div class="max-w-7xl mx-auto px-6 md:px-10 py-10">

        <a href="/Admin/Dashboard"
           class="text-xs font-semibold text-[var(--muted)] hover:text-[var(--red)]">
            ← Admin Dashboard
        </a>

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mt-4 mb-8">

            <div>
                <h1 class="font-display text-3xl">
                    Donations
                </h1>

                <p class="text-sm text-[var(--muted)] mt-2">
                    View and manage donations received by the sanctuary.
                </p>
            </div>

            <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-xl px-5 py-3">
                <p class="text-[10px] uppercase tracking-wider text-[var(--muted)]">
                    This month
                </p>
                <p class="text-xl font-semibold">
                    R12,450.00
                </p>
            </div>

        </div>

        <div class="flex gap-2 mb-5">

            <button class="px-4 py-2 bg-[var(--ink)] text-white rounded-lg text-xs font-semibold">
                All
            </button>

            <button class="px-4 py-2 border border-[var(--hairline)] rounded-lg text-xs font-semibold">
                Completed
            </button>

            <button class="px-4 py-2 border border-[var(--hairline)] rounded-lg text-xs font-semibold">
                Pending
            </button>

        </div>

        <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full text-sm">

                    <thead class="border-b border-[var(--hairline)] bg-[var(--cream)]/50">

                        <tr>
                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">Donor</th>
                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">Amount</th>
                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">Method</th>
                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">Date</th>
                            <th class="text-left px-6 py-4 text-[10px] uppercase tracking-wider text-[var(--muted)]">Status</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody class="divide-y divide-[var(--hairline)]">

                        <tr>
                            <td class="px-6 py-5">
                                <p class="font-semibold">Anonymous</p>
                                <p class="text-xs text-[var(--muted)]">anonymous@example.com</p>
                            </td>

                            <td class="px-6 py-5 font-semibold">
                                R500.00
                            </td>

                            <td class="px-6 py-5">
                                EFT
                            </td>

                            <td class="px-6 py-5">
                                14 Aug 2026
                            </td>

                            <td class="px-6 py-5">
                                <span class="status status-confirmed">
                                    Completed
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right">
                                <button class="text-xs font-semibold text-[var(--red)]">
                                    View
                                </button>
                            </td>
                        </tr>

                        <tr>
                            <td class="px-6 py-5">
                                <p class="font-semibold">John Smith</p>
                                <p class="text-xs text-[var(--muted)]">john@example.com</p>
                            </td>

                            <td class="px-6 py-5 font-semibold">
                                R250.00
                            </td>

                            <td class="px-6 py-5">
                                Card
                            </td>

                            <td class="px-6 py-5">
                                13 Aug 2026
                            </td>

                            <td class="px-6 py-5">
                                <span class="status status-confirmed">
                                    Completed
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right">
                                <button class="text-xs font-semibold text-[var(--red)]">
                                    View
                                </button>
                            </td>
                        </tr>

                        <tr>
                            <td class="px-6 py-5">
                                <p class="font-semibold">Priya N.</p>
                                <p class="text-xs text-[var(--muted)]">priya@example.com</p>
                            </td>

                            <td class="px-6 py-5 font-semibold">
                                R1,000.00
                            </td>

                            <td class="px-6 py-5">
                                PayPal
                            </td>

                            <td class="px-6 py-5">
                                12 Aug 2026
                            </td>

                            <td class="px-6 py-5">
                                <span class="status status-pending">
                                    Pending
                                </span>
                            </td>

                            <td class="px-6 py-5 text-right">
                                <button class="text-xs font-semibold text-[var(--red)]">
                                    View
                                </button>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>