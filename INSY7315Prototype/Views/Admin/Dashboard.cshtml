@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="max-w-6xl mx-auto px-6 md:px-12 pt-28 pb-20">

    <!-- Page heading -->
    <div class="mb-10">
        <p class="text-[11px] tracking-[0.2em] uppercase text-[var(--red)] font-semibold mb-2">
            Sanctuary management
        </p>

        <h1 class="font-display text-3xl md:text-4xl text-[var(--ink)] mb-3">
            Welcome back, Admin
        </h1>

        <p class="text-sm text-[var(--muted)] max-w-2xl">
            Here's a quick overview of what's happening at Kingdom Cats Sanctuary.
            Review bookings, event RSVPs, donations and community activity from here.
        </p>
    </div>


    <!-- Overview cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-10">

        <!-- Cats -->
        <a asp-controller="Cats" asp-action="Index"
           class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-5 hover:border-[var(--red)]/40 transition-colors">

            <div class="w-10 h-10 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 20c4.418 0 8-3.582 8-8 0-3.5-2-6.5-5-7.5M12 20c-4.418 0-8-3.582-8-8 0-3.5 2-6.5 5-7.5M9 7.5C9.5 5.5 10.5 4 12 4s2.5 1.5 3 3.5" />
                </svg>
            </div>

            <p class="text-2xl font-semibold text-[var(--ink)]">
                24
            </p>

            <p class="text-xs text-[var(--muted)] mt-1">
                Sanctuary cats
            </p>
        </a>


        <!-- Bookings -->
        <a asp-controller="Admin" asp-action="Bookings"
           class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-5 hover:border-[var(--red)]/40 transition-colors">

            <div class="w-10 h-10 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <rect x="3" y="4" width="18" height="17" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
            </div>

            <p class="text-2xl font-semibold text-[var(--ink)]">
                8
            </p>

            <p class="text-xs text-[var(--muted)] mt-1">
                Upcoming bookings
            </p>
        </a>


        <!-- Event RSVPs -->
        <a href="#event-rsvps"
           class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-5 hover:border-[var(--red)]/40 transition-colors">

            <div class="w-10 h-10 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M16 3h5v5M8 3H3v5M3 16v5h5M21 16v5h-5" />
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 8h10M7 12h10M7 16h6" />
                </svg>
            </div>

            <p class="text-2xl font-semibold text-[var(--ink)]">
                18
            </p>

            <p class="text-xs text-[var(--muted)] mt-1">
                Event RSVPs
            </p>
        </a>


        <!-- Donations -->
        <a asp-controller="Admin" asp-action="Donations"
           class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-5 hover:border-[var(--red)]/40 transition-colors">

            <div class="w-10 h-10 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 8c-2.5-3-7-1.5-7 2 0 4 7 9 7 9s7-5 7-9c0-3.5-4.5-5-7-2Z" />
                </svg>
            </div>

            <p class="text-2xl font-semibold text-[var(--ink)]">
                R12,450
            </p>

            <p class="text-xs text-[var(--muted)] mt-1">
                Donations received
            </p>
        </a>


        <!-- Community -->
        <a asp-controller="Admin" asp-action="Community"
           class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl p-5 hover:border-[var(--red)]/40 transition-colors">

            <div class="w-10 h-10 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M8 10h8M8 14h5M12 3a9 9 0 100 18 9 9 0 000-18Z" />
                </svg>
            </div>

            <p class="text-2xl font-semibold text-[var(--ink)]">
                6
            </p>

            <p class="text-xs text-[var(--muted)] mt-1">
                Recent community posts
            </p>
        </a>

    </div>


    <!-- Main dashboard grid -->
    <div class="grid lg:grid-cols-3 gap-6">


        <!-- Pending bookings -->
        <div class="lg:col-span-2">

            <div class="flex items-center justify-between mb-4">

                <div>
                    <h2 class="font-display text-2xl text-[var(--ink)]">
                        Booking requests
                    </h2>

                    <p class="text-sm text-[var(--muted)] mt-1">
                        Review visitors waiting for confirmation.
                    </p>
                </div>

                <a asp-controller="Admin"
                   asp-action="Bookings"
                   class="text-xs font-semibold uppercase tracking-wide text-[var(--red)] hover:text-[var(--red-dark)]">
                    View all
                </a>

            </div>


            <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">


                <!-- Booking 1 -->
                <div class="p-5 border-b border-[var(--hairline)]">

                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">

                        <div>

                            <div class="flex items-center gap-2 mb-1">

                                <h3 class="font-semibold text-sm text-[var(--ink)]">
                                    Sarah Naidoo
                                </h3>

                                <span class="text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-amber-50 text-amber-700">
                                    Pending
                                </span>

                            </div>

                            <p class="text-xs text-[var(--muted)]">
                                sarah@example.com
                            </p>

                            <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-xs text-[var(--muted)]">

                                <span>
                                    <strong class="text-[var(--ink)]">Session:</strong>
                                    Cat Viewing
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Date:</strong>
                                    20 August 2026
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Time:</strong>
                                    10:00
                                </span>

                            </div>

                        </div>


                        <div class="flex gap-2 shrink-0">

                            <button type="button"
                                    onclick="acceptBooking('Sarah Naidoo')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg bg-[var(--red)] text-white hover:opacity-90 transition-opacity">
                                Accept
                            </button>

                            <button type="button"
                                    onclick="rejectBooking('Sarah Naidoo')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-red-300 hover:text-red-600 transition-colors">
                                Reject
                            </button>

                        </div>

                    </div>

                </div>


                <!-- Booking 2 -->
                <div class="p-5 border-b border-[var(--hairline)]">

                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">

                        <div>

                            <div class="flex items-center gap-2 mb-1">

                                <h3 class="font-semibold text-sm text-[var(--ink)]">
                                    Jason Singh
                                </h3>

                                <span class="text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-amber-50 text-amber-700">
                                    Pending
                                </span>

                            </div>

                            <p class="text-xs text-[var(--muted)]">
                                jason@example.com
                            </p>

                            <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-xs text-[var(--muted)]">

                                <span>
                                    <strong class="text-[var(--ink)]">Session:</strong>
                                    Petting Session
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Date:</strong>
                                    21 August 2026
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Time:</strong>
                                    11:00
                                </span>

                            </div>

                        </div>


                        <div class="flex gap-2 shrink-0">

                            <button type="button"
                                    onclick="acceptBooking('Jason Singh')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg bg-[var(--red)] text-white hover:opacity-90 transition-opacity">
                                Accept
                            </button>

                            <button type="button"
                                    onclick="rejectBooking('Jason Singh')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-red-300 hover:text-red-600 transition-colors">
                                Reject
                            </button>

                        </div>

                    </div>

                </div>


                <!-- Booking 3 -->
                <div class="p-5">

                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">

                        <div>

                            <div class="flex items-center gap-2 mb-1">

                                <h3 class="font-semibold text-sm text-[var(--ink)]">
                                    Amy Govender
                                </h3>

                                <span class="text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-amber-50 text-amber-700">
                                    Pending
                                </span>

                            </div>

                            <p class="text-xs text-[var(--muted)]">
                                amy@example.com
                            </p>

                            <div class="flex flex-wrap gap-x-5 gap-y-2 mt-3 text-xs text-[var(--muted)]">

                                <span>
                                    <strong class="text-[var(--ink)]">Session:</strong>
                                    Cat Viewing
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Date:</strong>
                                    22 August 2026
                                </span>

                                <span>
                                    <strong class="text-[var(--ink)]">Time:</strong>
                                    14:00
                                </span>

                            </div>

                        </div>


                        <div class="flex gap-2 shrink-0">

                            <button type="button"
                                    onclick="acceptBooking('Amy Govender')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg bg-[var(--red)] text-white hover:opacity-90 transition-opacity">
                                Accept
                            </button>

                            <button type="button"
                                    onclick="rejectBooking('Amy Govender')"
                                    class="text-xs font-semibold px-4 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-red-300 hover:text-red-600 transition-colors">
                                Reject
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick actions -->
        <div>

            <h2 class="font-display text-2xl text-[var(--ink)] mb-1">
                Manage
            </h2>

            <p class="text-sm text-[var(--muted)] mb-4">
                Quick access to sanctuary content.
            </p>


            <div class="space-y-3">

                <!-- Cats -->
                <a asp-controller="Cats"
                   asp-action="Index"
                   class="flex items-center gap-4 bg-[var(--card)] border border-[var(--hairline)] rounded-xl p-4 hover:border-[var(--red)]/40 transition-colors">

                    <div class="w-10 h-10 shrink-0 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M12 20c4.418 0 8-3.582 8-8 0-3.5-2-6.5-5-7.5M12 20c-4.418 0-8-3.582-8-8 0-3.5 2-6.5 5-7.5" />

                        </svg>

                    </div>

                    <div class="flex-1">

                        <p class="text-sm font-semibold text-[var(--ink)]">
                            Cats
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            Add or update sanctuary cats
                        </p>

                    </div>

                    <span class="text-[var(--muted)]">
                        →
                    </span>

                </a>


                <!-- Events -->
                <a asp-controller="Events"
                   asp-action="Index"
                   class="flex items-center gap-4 bg-[var(--card)] border border-[var(--hairline)] rounded-xl p-4 hover:border-[var(--red)]/40 transition-colors">

                    <div class="w-10 h-10 shrink-0 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">

                            <rect x="3" y="4" width="18" height="17" rx="2" />
                            <path d="M16 2v4M8 2v4M3 10h18" />

                        </svg>

                    </div>

                    <div class="flex-1">

                        <p class="text-sm font-semibold text-[var(--ink)]">
                            Events
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            Manage sanctuary events
                        </p>

                    </div>

                    <span class="text-[var(--muted)]">
                        →
                    </span>

                </a>


                <!-- Merchandise -->
                <a asp-controller="Merch"
                   asp-action="Index"
                   class="flex items-center gap-4 bg-[var(--card)] border border-[var(--hairline)] rounded-xl p-4 hover:border-[var(--red)]/40 transition-colors">

                    <div class="w-10 h-10 shrink-0 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 7h12l1 14H5L6 7Zm3 0a3 3 0 016 0" />

                        </svg>

                    </div>

                    <div class="flex-1">

                        <p class="text-sm font-semibold text-[var(--ink)]">
                            Merchandise
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            Update products and availability
                        </p>

                    </div>

                    <span class="text-[var(--muted)]">
                        →
                    </span>

                </a>


                <!-- Community -->
                <a asp-controller="Admin"
                   asp-action="Community"
                   class="flex items-center gap-4 bg-[var(--card)] border border-[var(--hairline)] rounded-xl p-4 hover:border-[var(--red)]/40 transition-colors">

                    <div class="w-10 h-10 shrink-0 rounded-full bg-[var(--red)]/10 text-[var(--red)] flex items-center justify-center">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.5">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M8 10h8M8 14h5M12 3a9 9 0 100 18 9 9 0 000-18Z" />

                        </svg>

                    </div>

                    <div class="flex-1">

                        <p class="text-sm font-semibold text-[var(--ink)]">
                            Community
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            Review community posts
                        </p>

                    </div>

                    <span class="text-[var(--muted)]">
                        →
                    </span>

                </a>

            </div>

        </div>

    </div>


    <!-- Event RSVPs -->
    <div id="event-rsvps" class="mt-10">

        <div class="flex items-center justify-between mb-4">

            <div>

                <h2 class="font-display text-2xl text-[var(--ink)]">
                    Event RSVPs
                </h2>

                <p class="text-sm text-[var(--muted)] mt-1">
                    See who has RSVP'd for upcoming sanctuary events.
                </p>

            </div>

            <a asp-controller="Events"
               asp-action="Index"
               class="text-xs font-semibold uppercase tracking-wide text-[var(--red)] hover:text-[var(--red-dark)]">
                View events
            </a>

        </div>


        <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

            <!-- Table heading -->
            <div class="hidden md:grid grid-cols-5 gap-4 px-5 py-3 border-b border-[var(--hairline)] text-[10px] uppercase tracking-wider font-semibold text-[var(--muted)]">

                <span>Attendee</span>
                <span>Event</span>
                <span>Guests</span>
                <span>Status</span>
                <span class="text-right">Action</span>

            </div>


            <!-- RSVP 1 -->
            <div class="p-5 border-b border-[var(--hairline)]">

                <div class="grid md:grid-cols-5 gap-4 items-center">

                    <div>

                        <p class="font-semibold text-sm text-[var(--ink)]">
                            Thandiwe Ngcobo
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            thandiwe@example.com
                        </p>

                    </div>

                    <div>

                        <p class="text-sm text-[var(--ink)]">
                            KCS Adoption Day
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            24 August 2026 · 10:00
                        </p>

                    </div>

                    <div class="text-sm text-[var(--ink)]">
                        2 guests
                    </div>

                    <div>

                        <span class="inline-flex text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-green-50 text-green-700">
                            Confirmed
                        </span>

                    </div>

                    <div class="flex md:justify-end gap-2">

                        <button type="button"
                                onclick="viewRSVP('Thandiwe Ngcobo', 'KCS Adoption Day')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-[var(--red)] hover:text-[var(--red)] transition-colors">
                            View
                        </button>

                        <button type="button"
                                onclick="cancelRSVP('Thandiwe Ngcobo')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition-colors">
                            Cancel
                        </button>

                    </div>

                </div>

            </div>


            <!-- RSVP 2 -->
            <div class="p-5 border-b border-[var(--hairline)]">

                <div class="grid md:grid-cols-5 gap-4 items-center">

                    <div>

                        <p class="font-semibold text-sm text-[var(--ink)]">
                            Jason Singh
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            jason@example.com
                        </p>

                    </div>

                    <div>

                        <p class="text-sm text-[var(--ink)]">
                            Fundraising Walk
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            5 September 2026 · 09:00
                        </p>

                    </div>

                    <div class="text-sm text-[var(--ink)]">
                        1 guest
                    </div>

                    <div>

                        <span class="inline-flex text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-amber-50 text-amber-700">
                            Pending
                        </span>

                    </div>

                    <div class="flex md:justify-end gap-2">

                        <button type="button"
                                onclick="acceptRSVP('Jason Singh')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg bg-[var(--red)] text-white hover:opacity-90 transition-opacity">
                            Accept
                        </button>

                        <button type="button"
                                onclick="rejectRSVP('Jason Singh')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-red-300 hover:text-red-600 transition-colors">
                            Reject
                        </button>

                    </div>

                </div>

            </div>


            <!-- RSVP 3 -->
            <div class="p-5">

                <div class="grid md:grid-cols-5 gap-4 items-center">

                    <div>

                        <p class="font-semibold text-sm text-[var(--ink)]">
                            Amy Govender
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            amy@example.com
                        </p>

                    </div>

                    <div>

                        <p class="text-sm text-[var(--ink)]">
                            KCS Adoption Day
                        </p>

                        <p class="text-xs text-[var(--muted)]">
                            24 August 2026 · 10:00
                        </p>

                    </div>

                    <div class="text-sm text-[var(--ink)]">
                        3 guests
                    </div>

                    <div>

                        <span class="inline-flex text-[10px] uppercase tracking-wide font-semibold px-2 py-1 rounded-full bg-amber-50 text-amber-700">
                            Pending
                        </span>

                    </div>

                    <div class="flex md:justify-end gap-2">

                        <button type="button"
                                onclick="acceptRSVP('Amy Govender')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg bg-[var(--red)] text-white hover:opacity-90 transition-opacity">
                            Accept
                        </button>

                        <button type="button"
                                onclick="rejectRSVP('Amy Govender')"
                                class="text-xs font-semibold px-3 py-2 rounded-lg border border-[var(--hairline)] text-[var(--ink)] hover:border-red-300 hover:text-red-600 transition-colors">
                            Reject
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Recent donations -->
    <div class="mt-10">

        <div class="flex items-center justify-between mb-4">

            <div>

                <h2 class="font-display text-2xl text-[var(--ink)]">
                    Recent donations
                </h2>

                <p class="text-sm text-[var(--muted)] mt-1">
                    The latest contributions made to the sanctuary.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Donations"
               class="text-xs font-semibold uppercase tracking-wide text-[var(--red)] hover:text-[var(--red-dark)]">
                View all
            </a>

        </div>


        <div class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

            <div class="grid grid-cols-4 gap-4 px-5 py-3 border-b border-[var(--hairline)] text-[10px] uppercase tracking-wider font-semibold text-[var(--muted)]">

                <span>Donor</span>
                <span>Amount</span>
                <span>Method</span>
                <span>Status</span>

            </div>


            <div class="grid grid-cols-4 gap-4 px-5 py-4 text-sm border-b border-[var(--hairline)]">

                <span class="font-medium text-[var(--ink)]">
                    John Smith
                </span>

