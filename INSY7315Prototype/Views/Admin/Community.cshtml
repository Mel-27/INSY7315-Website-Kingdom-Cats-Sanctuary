@{
    ViewData["Title"] = "Manage Community";
}

<div class="min-h-screen bg-[var(--cream)]">

    <div class="max-w-6xl mx-auto px-6 md:px-10 py-10">

        <a href="/Admin/Dashboard"
           class="text-xs font-semibold text-[var(--muted)] hover:text-[var(--red)]">
            ← Admin Dashboard
        </a>

        <div class="mt-4 mb-8">

            <h1 class="font-display text-3xl">
                Community
            </h1>

            <p class="text-sm text-[var(--muted)] mt-2">
                Review and manage stories shared by the KCS community.
            </p>

        </div>

        <div class="grid md:grid-cols-2 gap-5">

            <!-- POST -->
            <article class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

                <div class="h-52 bg-[var(--cream)] flex items-center justify-center text-4xl">
                    🐱
                </div>

                <div class="p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <h2 class="font-semibold">
                                Thandiwe Ngcobo
                            </h2>

                            <p class="text-xs text-[var(--muted)]">
                                14 August 2026
                            </p>
                        </div>

                        <span class="text-[10px] uppercase tracking-wider bg-green-50 text-green-700 px-2 py-1 rounded-full">
                            Published
                        </span>

                    </div>

                    <p class="text-sm text-[var(--muted)] leading-relaxed mt-4">
                        We had such a lovely adoption experience at Kingdom Cats Sanctuary. Luna has settled into her new home beautifully!
                    </p>

                    <div class="flex gap-2 mt-5">

                        <button class="flex-1 border border-[var(--hairline)] rounded-lg py-2 text-xs font-semibold">
                            View
                        </button>

                        <button class="flex-1 border border-[var(--hairline)] rounded-lg py-2 text-xs font-semibold">
                            Hide
                        </button>

                        <button class="flex-1 bg-red-50 text-red-600 rounded-lg py-2 text-xs font-semibold">
                            Delete
                        </button>

                    </div>

                </div>

            </article>

            <!-- POST -->
            <article class="bg-[var(--card)] border border-[var(--hairline)] rounded-2xl overflow-hidden">

                <div class="h-52 bg-[var(--cream)] flex items-center justify-center text-4xl">
                    ❤️
                </div>

                <div class="p-6">

                    <div class="flex items-center justify-between">

                        <div>
                            <h2 class="font-semibold">
                                Jason Singh
                            </h2>

                            <p class="text-xs text-[var(--muted)]">
                                12 August 2026
                            </p>
                        </div>

                        <span class="text-[10px] uppercase tracking-wider bg-green-50 text-green-700 px-2 py-1 rounded-full">
                            Published
                        </span>

                    </div>

                    <p class="text-sm text-[var(--muted)] leading-relaxed mt-4">
                        Thank you to everyone at the sanctuary for helping us find the perfect cat for our family.
                    </p>

                    <div class="flex gap-2 mt-5">

                        <button class="flex-1 border border-[var(--hairline)] rounded-lg py-2 text-xs font-semibold">
                            View
                        </button>

                        <button class="flex-1 border border-[var(--hairline)] rounded-lg py-2 text-xs font-semibold">
                            Hide
                        </button>

                        <button class="flex-1 bg-red-50 text-red-600 rounded-lg py-2 text-xs font-semibold">
                            Delete
                        </button>

                    </div>

                </div>

            </article>

        </div>

    </div>

</div>